{
  "name": "svgx",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "vscode",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.57.0"
  },
  "activationEvents": [
    "onCustomEditor:svgx.editor"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/svgxMain.js",
  "browser": "./dist/browser/svgxMain.browser.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "svgx.editor",
        "displayName": "SVGX Editor",
        "selector": [
          {
            "filenamePattern": "*.svgx"
          },
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "svgx.copyLogical",
        "title": "Copy Logical",
        "category": "SVGX"
      },
      {
        "command": "svgx.pasteLogical",
        "title": "Paste Logical",
        "category": "SVGX"
      },
      {
          "command": "svgx.encodePathLegend",
          "title": "Associate Legend",
          "category": "SVGX"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.copyLogical",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.pasteLogical",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.encodePathLegend",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.copyLogical",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.pasteLogical",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'svgx.editor'",
          "command": "svgx.encodePathLegend",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npx gulp compile-extension:svgx && npm run compile:webview",
    "watch": "npx gulp watch-extension:svgx && npm run watch:webview",
    "compile:webview": "node ./esbuild.mjs",
    "watch:webview": "node ./esbuild.mjs --watch"
  },
  "dependencies": {
    "@enonic/fnv-plus": "^1.3.0",
    "detect-indent": "^6.0.0",
    "@xmldom/xmldom": "^0.8.10"
  },
  "devDependencies": {
    "@types/vscode": "^1.57.0",
    "@types/xmldom": "^0.1.34",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
