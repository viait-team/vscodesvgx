{
  "name": "visual-xml-editor",
  "displayName": "Visual XML Editor",
  "description": "A visual editor for XML files.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onCustomEditor:xml.visualEditor"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "xml.visualEditor",
        "displayName": "Visual XML Editor",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/webpack": "^5.28.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2"
  }
}
