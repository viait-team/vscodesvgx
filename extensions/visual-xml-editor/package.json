{
  "name": "visual-xml-editor",
  "displayName": "Visual XML Editor",
  "description": "A visual editor for XML files.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onCustomEditor:xml.visualEditor"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "npx gulp compile-extension:visual-xml-editor && npx gulp --gulpfile ./gulpfile.copy-webview.js copy-webview",
    "watch": "npx gulp watch-extension:visual-xml-editor"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "xml.visualEditor",
        "displayName": "Visual XML Editor",
        "selector": [
            {
              "filenamePattern": "*.xml"
            },
            {
              "filenamePattern": "*.svg"
            },
            {
              "filenamePattern": "*.svgx"
            }
          ]
      }
    ]
  },
  "files": [
    "out/**",
    "dist/**",
    "webview/**",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "fast-xml-parser": "^5.3.0",
    "typescript": "^5.3.2"
  }
}
