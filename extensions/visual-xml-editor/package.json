{
  "name": "visual-xml-editor",
  "displayName": "Visual XML Editor",
  "description": "A visual editor for XML files.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onCustomEditor:xml.visualEditor",
    "onCommand:xml.showPreview"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "npx gulp compile-extension:visual-xml-editor && npx gulp --gulpfile ./gulpfile.copy-webview.js copy-webview",
    "watch": "npx gulp watch-extension:visual-xml-editor"
  },
  "contributes": {
    "commands": [
      {
        "command": "xml.showPreview",
        "title": "Open Preview",
        "category": "XML"
      },
      {
        "command": "xml.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "XML"
      },
      {
        "command": "xml.openInBrowser",
        "title": "Open in Browser",
        "category": "XML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.showPreviewToSide",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.showPreview",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.showPreviewToSide",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.openInBrowser",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.showPreview"
        },
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.showPreviewToSide"
        },
        {
          "when": "activeCustomEditorId == 'xml.visualEditor'",
          "command": "xml.openInBrowser"
        }
      ]
    },
    "configuration": {
      "title": "XML",
      "properties": {
        "xml.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the preview with the editor."
        },
        "xml.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the editor with the preview."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "xml.visualEditor",
        "displayName": "Visual XML Editor",
        "selector": [
          {
            "filenamePattern": "*.xml"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.svgx"
          }
        ]
      }
    ]
  },
  "files": [
    "out/**",
    "dist/**",
    "webview/**",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "fast-xml-parser": "^5.3.0",
    "typescript": "^5.3.2"
  }
}
